APP_NAME=Risk Platform API
ENVIRONMENT=development

# Used by the db service (compose interpolation)
POSTGRES_USER=risk
POSTGRES_PASSWORD=risk
POSTGRES_DB=riskdb

# Used by the api service (app settings)
DATABASE_URL=postgresql+asyncpg://risk:risk@db:5432/riskdb
REDIS_URL=redis://redis:6379/0
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
